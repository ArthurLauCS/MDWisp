{
  "name": "mdwisp",
  "version": "0.4.1",
  "private": true,
  "description": "Markdown reader + editor with folder-based documents, local code language detection and a Claude-inspired dark-first UI.",
  "main": "./out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "dev.mdview.app",
    "productName": "MDWisp",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json", "LICENSE"],
    "extraResources": [
      { "from": "stock", "to": "stock" },
      { "from": "plugin", "to": "plugin" },
      { "from": "src/renderer/src/styles", "to": "styles", "filter": ["tokens.css", "fonts.css", "base.css", "markdown.css", "fonts/**/*"] }
    ],
    "fileAssociations": [
      { "ext": ["md", "markdown"], "name": "Markdown", "description": "Markdown document", "role": "Editor" }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "MDWisp-${version}-setup.${ext}"
    },
    "nsis": {
      "installerLanguages": ["en_US", "zh_CN"],
      "displayLanguageSelector": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "MDWisp"
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "chokidar": "^3.6.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.10.0",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
